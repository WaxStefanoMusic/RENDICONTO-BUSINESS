{
  "name": "rendiconto-business-desktop",
  "version": "2.14.1",
  "description": "Gestionale contabile e fiscale per SNC in contabilità semplificata: entrate, acquisti, LIPE, imposte soci e INPS",
  "main": "main.js",
  "author": "Mattew",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i src/tailwind.css -o renderer/app.css --minify",
    "start": "npm run css && electron .",
    "dev": "npm run css && electron . --enable-logging",
    "dist": "npm run css && electron-builder --win nsis portable --publish never",
    "installer": "npm run dist",
    "pack": "npm run css && electron-builder --dir",
    "release": "npm run css && electron-builder --win nsis portable --publish always",
    "vendor:pdf": "node -e \"for (const f of ['pdf.min.mjs','pdf.worker.min.mjs']) require('fs').copyFileSync('node_modules/pdfjs-dist/build/'+f, 'renderer/lib/'+f)\""
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "pdfjs-dist": "4.10.38",
    "tailwindcss": "^4.3.5"
  },
  "build": {
    "appId": "it.mattew.rendiconto.business",
    "productName": "Rendicontazione Business",
    "directories": {
      "output": "Installer"
    },
    "files": [
      "**/*",
      "!Installer/**",
      "!build/**",
      "!src/**",
      "!avvia.cmd",
      "!*.md"
    ],
    "win": {
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gestionale SNC",
      "include": "build/installer.nsh",
      "perMachine": false,
      "artifactName": "Rendicontazione-Business-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "GestionaleSNC-portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "WaxStefanoMusic",
        "repo": "RENDICONTO-BUSINESS",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
