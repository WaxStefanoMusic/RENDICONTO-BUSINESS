{
  "name": "rendiconto-business-desktop",
  "version": "1.0.0",
  "description": "Rendicontazione Business — fatture emesse e ricevute, corrispettivi, commercialista, scadenze",
  "main": "main.js",
  "author": "Mattew",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "installer": "electron-builder --win nsis portable",
    "dist": "electron-builder --win nsis portable",
    "pack": "electron-builder --dir",
    "release": "electron-builder --win nsis portable --publish always"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "it.mattew.rendiconto.business",
    "productName": "Rendicontazione Business",
    "directories": {
      "output": "Installer"
    },
    "files": [
      "**/*",
      "!Installer/**",
      "!Documenti/**",
      "!build/**",
      "!sync-core.js",
      "!avvia.cmd",
      "!*.md",
      "!**/_body.html",
      "!business-patch.js"
    ],
    "win": {
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rendicontazione Business",
      "include": "build/installer.nsh",
      "perMachine": false,
      "artifactName": "Rendicontazione-Business-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "RendicontazioneBusiness-portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "WaxStefanoMusic",
        "repo": "RENDICONTO-BUSINESS",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
